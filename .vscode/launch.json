// A launch configuration that compiles the extension and then opens it inside a new window
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/tests/fixtures/single-root-workspace",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-extensions"
			],
			"outFiles": ["${workspaceFolder}/dist/*.js"],
			"preLaunchTask": "npm: watch"
		},
		{
			"name": "Run Extension with workspace",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/tests/fixtures/multi-root-workspace/test.code-workspace",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-extensions"
			],
			"outFiles": ["${workspaceFolder}/dist/*.js"],
			"preLaunchTask": "npm: watch"
		},
		{
			"type": "node",
			"request": "attach",
			"name": "Attach to Server",
			"address": "localhost",
			"port": 6011,
			"outFiles": ["${workspaceFolder}/dist/*.js"]
		},
		{
			"name": "Test Extension",
			"type": "extensionHost",
			"request": "launch",
			"testConfiguration": "${workspaceFolder}/.vscode-test.js",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}"],
			"outFiles": ["${workspaceFolder}/dist/*.js"],
			"preLaunchTask": "npm: build"
		}
	],
	"compounds": [
		{
			"name": "Run Extension + Attach Server",
			"configurations": ["Run Extension", "Attach to Server"]
		}
	]
}
